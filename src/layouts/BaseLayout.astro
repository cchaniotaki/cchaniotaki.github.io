---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import SideBarFooter from "../components/SideBarFooter.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
const { image, title = SITE_TITLE, description = SITE_DESCRIPTION, sideBarActiveItemID } = Astro.props;
const links = [['home','/','About'],['projects','/projects','Work Projects'],['research','/research','Research Projects'],['teaching','/teaching','Teaching Experience'],['cv','/cv','Curriculum Vitae (CV)'],['contact','/contact','Contact']];
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head><BaseHead title={title} description={description} image={image} /></head>
  <body>
    <div class="space-backdrop" aria-hidden="true"><span class="space-orbit"></span></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <aside class="profile-panel">
        <a href="/" class="portrait-link"><img src="/profile.png" alt="Christina Chaniotaki" width="176" height="176" /></a>
        <div class="profile-name">Christina Chaniotaki</div>
        <div class="profile-quotes"><i>"Αγωνίσου για την ζωή που ονειρεύεσαι"</i><br /><i>"Strive for the life you dream of"</i></div>
        <nav aria-label="Main navigation">{links.map(([id,href,label]) => <a href={href} aria-current={id === sideBarActiveItemID ? 'page' : undefined}><span>{label}</span><span aria-hidden="true">↗</span></a>)}</nav>
        <SideBarFooter />
      </aside>
      <main id="main" class="page-content"><slot /></main>
    </div>
    <Footer />
  </body>
</html>
